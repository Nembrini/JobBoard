# Variabili del lato Vercel. Copiare in web/.env.local per lo sviluppo locale e
# replicare nelle Environment Variables del progetto Vercel per la produzione.
#
# Nessuna di queste ha il prefisso NEXT_PUBLIC_: sono tutte segrete e devono restare
# fuori dal bundle del browser.

# --- Database: pooler Supavisor, NON la connessione diretta ---
# Le funzioni serverless aprono e chiudono connessioni di continuo; una connessione
# diretta esaurirebbe il pool di Supabase.
POSTGRES_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Supabase Storage: signed URL per scaricare i CV generati ---
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes

# --- Auth.js ---
AUTH_SECRET=                       # generare con: npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Allowlist: l'unico account Google ammesso. Ogni altro viene respinto al callback.
AUTH_ALLOWED_EMAIL=tua-email@gmail.com
