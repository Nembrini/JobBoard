# Variabili del lato Vercel. Copiare in web/.env.local per lo sviluppo locale e
# replicare nelle Environment Variables del progetto Vercel per la produzione.
#
# Nessuna di queste ha il prefisso NEXT_PUBLIC_: sono tutte segrete e devono restare
# fuori dal bundle del browser.
#
# ATTENZIONE al formato: il valore e' tutto cio' che segue il primo "=", commento
# incluso. Scrivere "AUTH_SECRET=            # generalo con..." significa avere un
# AUTH_SECRET fatto di spazi e di un commento. I commenti vanno su una riga a parte.

# --- Database: pooler Supavisor, NON la connessione diretta ---
# Le funzioni serverless aprono e chiudono connessioni di continuo; una connessione
# diretta esaurirebbe il pool di Supabase.
# Il certificato TLS del pooler e' fissato nel codice (src/db/supabase-ca.ts): senza,
# `pg` si collegherebbe in chiaro.
POSTGRES_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Supabase Storage: signed URL per scaricare i CV generati ---
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes

# --- Auth.js ---
# Generare con: npx auth secret
AUTH_SECRET=

# Da Google Cloud Console -> API e servizi -> Credenziali -> ID client OAuth 2.0.
# Origine JavaScript autorizzata:  https://IL-TUO-DOMINIO
# URI di reindirizzamento:         https://IL-TUO-DOMINIO/api/auth/callback/google
# In locale valgono http://localhost:3000 e http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Allowlist: l'unico account Google ammesso. Ogni altro viene respinto nel callback
# signIn, prima che esista un cookie di sessione. In produzione, senza questa
# variabile l'applicazione si rifiuta di partire.
AUTH_ALLOWED_EMAIL=tua-email@gmail.com
