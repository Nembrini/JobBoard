# =============================================================================
# Template delle variabili d'ambiente.
# Copia in worker/.env (per il worker) e replica nelle Environment Variables
# del progetto Vercel dove indicato. NON committare mai il file .env compilato.
# =============================================================================

# --- Database (Supabase, region eu-central-1) --------------------------------
# Worker e Alembic: SESSION pooler, porta 5432.
# Non la connessione diretta db.PROJECT.supabase.co: quella pubblica solo un record
# AAAA (IPv6) e su una rete senza IPv6 non si risolve nemmeno.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Vercel: TRANSACTION pooler, porta 6543. Le funzioni serverless aprono e chiudono
# connessioni di continuo e senza pooler esaurirebbero i posti disponibili.
POSTGRES_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ATTENZIONE alla password: se contiene / : @ ? # o %, va codificata in percent-encoding
# (/ diventa %2F, : diventa %3A) oppure la stringa di connessione non viene interpretata
# correttamente. Piu' semplice: impostare in Supabase una password solo alfanumerica.?pgbouncer=true

# --- Supabase Storage --------------------------------------------------------
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # segreto: solo worker e server Next.js
SUPABASE_STORAGE_BUCKET=resumes       # bucket PRIVATO

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
MODEL_SCORING=claude-haiku-4-5-20251001
MODEL_CV=claude-opus-5

# --- Auth (solo Vercel) ------------------------------------------------------
AUTH_SECRET=                          # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ALLOWED_EMAIL=tua-email@gmail.com   # allowlist: un solo account

# --- Fonti annunci -----------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
RAPIDAPI_KEY=                         # per JSearch (Google for Jobs)
# Arbeitnow, Remotive, RemoteOK e le board ATS pubbliche non richiedono chiave

# --- Email (dalla Fase 8) ----------------------------------------------------
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=                   # richiede 2FA attiva sull'account Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com

# --- Comportamento del worker ------------------------------------------------
DRY_RUN=true                          # true finche' non hai verificato il Tier A
DAILY_APPLICATION_CAP=10
MATCH_THRESHOLD=65
DAILY_RUN_HOUR=7
TASK_POLL_SECONDS=30
PUBLIC_APP_URL=https://your-app.vercel.app
