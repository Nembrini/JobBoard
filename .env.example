# =============================================================================
# Template delle variabili d'ambiente.
# Copia in worker/.env (per il worker) e replica nelle Environment Variables
# del progetto Vercel dove indicato. NON committare mai il file .env compilato.
# =============================================================================

# --- Database (Supabase, region eu-central-1) --------------------------------
# Worker e Alembic: SESSION pooler, porta 5432.
# Non la connessione diretta db.PROJECT.supabase.co: quella pubblica solo un record
# AAAA (IPv6) e su una rete senza IPv6 non si risolve nemmeno.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Vercel: TRANSACTION pooler, porta 6543. Le funzioni serverless aprono e chiudono
# connessioni di continuo e senza pooler esaurirebbero i posti disponibili.
POSTGRES_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ATTENZIONE alla password: se contiene / : @ ? # o %, va codificata in percent-encoding
# (/ diventa %2F, : diventa %3A) oppure la stringa di connessione non viene interpretata
# correttamente. Piu' semplice: impostare in Supabase una password solo alfanumerica.

# ATTENZIONE al formato delle righe: il commento va SOPRA la variabile, mai
# dopo un valore vuoto sulla stessa riga. Scrivere
#
#     RAPIDAPI_KEY=            # per JSearch
#
# non lascia la variabile vuota: python-dotenv riconosce un commento in coda solo
# quando davanti c'e' un valore, quindi senza valore il commento *diventa* il
# valore. Il risultato e' una chiave che passa ogni controllo di presenza e vale
# "# per JSearch". E' gia' successo due volte, con AUTH_SECRET e con RAPIDAPI_KEY.
# `jobboard doctor` ora se ne accorge, ma e' meglio non crearlo, il caso.

# --- Supabase Storage --------------------------------------------------------
SUPABASE_URL=https://PROJECT.supabase.co
# segreto: solo worker e server Next.js
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes       # bucket PRIVATO

# --- LLM ---------------------------------------------------------------------
# Provider degli stadi LLM: gemini | anthropic | ollama.
# Gli embedding sono SEMPRE locali su CPU (fastembed) e non costano nulla:
# questa scelta riguarda solo estrazione requisiti, scoring e riscrittura del CV.
LLM_PROVIDER=gemini

# Chiave gratuita da https://aistudio.google.com -> Get API key.
# Nessuna carta di credito richiesta.
GEMINI_API_KEY=
MODEL_SCORING=gemini-3.5-flash-lite
MODEL_CV=gemini-3.6-flash

# Solo se LLM_PROVIDER=anthropic (a consumo, richiede un metodo di pagamento)
ANTHROPIC_API_KEY=
# Solo se LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# --- Auth (solo Vercel) ------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ALLOWED_EMAIL=tua-email@gmail.com   # allowlist: un solo account

# --- Fonti annunci -----------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
# per JSearch (Google for Jobs)
RAPIDAPI_KEY=
# Arbeitnow, Remotive, RemoteOK e le board ATS pubbliche non richiedono chiave

# --- Email (dalla Fase 8) ----------------------------------------------------
GMAIL_ADDRESS=
# richiede 2FA attiva sull'account Google
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com

# --- Comportamento del worker ------------------------------------------------
DRY_RUN=true                          # true finche' non hai verificato il Tier A
DAILY_APPLICATION_CAP=10
MATCH_THRESHOLD=65
DAILY_RUN_HOUR=7
TASK_POLL_SECONDS=30
BACKUP_KEEP_COUNT=14                  # quanti backup tenere in data/backups/ (Fase 10.3)
PUBLIC_APP_URL=https://job-board-official.vercel.app
